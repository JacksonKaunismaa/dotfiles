# Transparent colorscheme — uses terminal default for backgrounds so kitty's
# background_opacity shows through. Used by notes-scratch (~/.local/bin/notes-scratch-toggle).
# Foreground colors are still set so syntax highlighting remains readable.

color-link default               ",default"
color-link line-number           "243,default"
color-link current-line-number   "248,default"
color-link gutter-error          "red,default"
color-link gutter-warning        "yellow,default"
color-link cursor-line           ",default"
color-link color-column          ",default"
color-link indent-char           "240,default"
color-link tab-error             "red,default"
color-link trailingws            "red,default"
color-link statusline            "black,250"
color-link tabbar                "black,250"
color-link tabbar.active         "white,238"
color-link scrollbar             ",default"
color-link divider               "243,default"
color-link message               "248,default"
color-link error-message         "red,default"
color-link diff-added            "green,default"
color-link diff-modified         "yellow,default"
color-link diff-deleted          "red,default"

color-link selection             ",238"
color-link hlsearch              "black,yellow"
color-link match-brace           ",238"

color-link comment               "245,default"
color-link identifier            "default,default"
color-link constant              "180,default"
color-link constant.string       "144,default"
color-link constant.specialChar  "168,default"
color-link statement             "110,default"
color-link symbol                "default,default"
color-link symbol.operator       "default,default"
color-link preproc               "175,default"
color-link type                  "150,default"
color-link special               "175,default"
color-link underlined            "underline default,default"
color-link error                 "bold red,default"
color-link todo                  "bold 175,default"
