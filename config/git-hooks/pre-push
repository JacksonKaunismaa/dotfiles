#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# Skip git-lfs for repos that track no LFS files. Otherwise `git lfs pre-push`
# does lock-verify + transfer-probe SSH round-trips to the remote on every push
# — each an extra security-key touch — for zero benefit. (git lfs ls-files is
# local/no-network; checks HEAD, so a branch whose tip has no LFS files but
# whose history does would be skipped — swap for `--all` if that matters.)
[ -n "$(git lfs ls-files -n 2>/dev/null | head -1)" ] || exit 0
git lfs pre-push "$@"
